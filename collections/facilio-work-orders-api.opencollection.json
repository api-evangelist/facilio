          "docs": "Returns a paginated list of work orders. Supports filtering, sorting, field selection, and saved views.\nBy default, returns module-configured fields. Use `?select=` to customize.\nCustom fields can be included via `?select=subject,po_reference_workorder`.\n"
        },
        {
          "info": {
            "name": "Create a work order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{region}.facilioapis.com/{app_name}/api/v5/workorder",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new work order. Requires `subject` and `site` at minimum.\nPicklist fields (priority, category, type) accept display name strings (e.g. `\"High\"`) or numeric IDs.\nCustom fields can be passed alongside system fields.\n"
        },
        {
          "info": {
            "name": "Get a work order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{region}.facilioapis.com/{app_name}/api/v5/workorder/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Record ID"
              },
              {
                "name": "select",
                "value": "",
                "type": "query",
                "description": "Comma-separated field names to include in the response"
              },
              {
                "name": "expand",
                "value": "",
                "type": "query",
                "description": "Comma-separated lookup field names to expand on **list** endpoints (max 5).\nExpanded objects follow the same rules as single-record GET (see **Lookup fields in responses** in the API overview).\n"
              }
            ]
