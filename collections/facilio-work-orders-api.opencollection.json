            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Record ID"
              },
              {
                "name": "taskId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete work order task"
        },
        {
