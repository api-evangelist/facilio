        {
          "info": {
            "name": "Delete a work order",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{region}.facilioapis.com/{app_name}/api/v5/workorder/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Record ID"
              }
            ]
          },
          "docs": "Permanently deletes a work order. This action cannot be undone."
        },
