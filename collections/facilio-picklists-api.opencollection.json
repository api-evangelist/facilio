        {
          "info": {
            "name": "Get picklist values for a custom field",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{region}.facilioapis.com/{app_name}/api/v5/picklist/:moduleName/:fieldName",
            "params": [
              {
                "name": "moduleName",
                "value": "",
                "type": "path",
                "description": "Module name (e.g. `workorder`, `asset`)"
              },
              {
                "name": "fieldName",
                "value": "",
                "type": "path",
                "description": "Field name (e.g. `urgency`, `warranty_type_asset`)"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Filter picklist values by name"
              }
            ]
          },
          "docs": "Returns picklist values for custom enum or system picklist fields.\nOnly enum-type and system picklist lookup fields are supported.\nFor regular lookup fields (site, building, asset), use the module's list API instead.\n"
