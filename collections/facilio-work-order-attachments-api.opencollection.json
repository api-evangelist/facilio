{
  "opencollection": "1.0.0",
  "info": {
    "name": "Facilio REST Assets Work Order Attachments API",
    "version": "5.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Work Order Attachments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List work order attachments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{region}.facilioapis.com/{app_name}/api/v5/workorder/:id/attachments",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Record ID"
              }
            ]
          },
          "docs": "Returns all file attachments for the specified work order."
        },
        {
          "info": {
            "name": "Add work order attachment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{region}.facilioapis.com/{app_name}/api/v5/workorder/:id/attachments",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Record ID"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "attachment",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads a file attachment to the specified work order. Use multipart/form-data."
        },
        {
          "info": {
            "name": "Delete work order attachment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{region}.facilioapis.com/{app_name}/api/v5/workorder/:id/attachments/:attachmentId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Record ID"
              },
              {
                "name": "attachmentId",
                "value": "",
                "type": "path",
                "description": "Attachment ID"
              }
            ]
          },
          "docs": "Deletes a specific attachment from the work order."
        },
        {
          "info": {
            "name": "Download work order attachment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{region}.facilioapis.com/{app_name}/api/v5/workorder/:id/attachments/:attachmentId/download",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Record ID"
              },
              {
                "name": "attachmentId",
                "value": "",
                "type": "path",
                "description": "Attachment ID"
              }
            ]
          },
          "docs": "Downloads the file content of a specific attachment. Returns the raw file with appropriate Content-Type and Content-Disposition headers."
        }
      ]
    }
  ],
  "bundled": true
}